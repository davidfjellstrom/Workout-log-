# PostgreSQL connection string.
# Vercel Postgres hands out "postgres://" URLs; the app rewrites them to
# "postgresql://" automatically, so either form works here.
DATABASE_URL=postgresql://user:password@localhost:5432/workoutlog

# Key used to sign JWTs. Generate one with: openssl rand -hex 32
SECRET_KEY=

# development | production
# Controls the auth cookie's Secure/SameSite attributes.
ENVIRONMENT=development

# Comma-separated list of frontend origins allowed by CORS.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
